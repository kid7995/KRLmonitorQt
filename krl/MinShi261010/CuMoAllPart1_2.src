;---- Move to station 1 P11 for grinding phase ----
   PassNo = -11       ; zhuan yi dao gong wei 1
;FOLD SPTP P11 Vel=100 % PDAT1 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=P11; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT1; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
;ENDFOLD
SPTP XP11 WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FP11), $BASE = SBASE(FP11.BASE_NO), $IPO_MODE = SIPO_MODE(FP11.IPO_FRAME), $LOAD = SLOAD(FP11.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT1), $APO = SAPO_PTP(PPDAT1), $GEAR_JERK[1] = SGEAR_JERK(PPDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
   WAIT SEC 0

;---- Grinding station 1 ----
   PassNo = -11       ; da mo gong wei 1 : fei da mo duan
   ESpos = InitLen1
;FOLD LIN P14 Vel=0.1 m/s CPDAT13 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P14; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT13; Kuka.VelocityPath=0.1; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT13
FDAT_ACT = FP14
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS (0)
LIN XP14
;ENDFOLD
;---- zong qi dong ----   
   Sspeed = 8000
   WAIT FOR Rotation_R>Sspeed-500
      
;FOLD LIN P15 CONT Vel=0.02 m/s CPDAT14 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P15; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDAT14; Kuka.VelocityPath=0.02; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT14
FDAT_ACT = FP15
BAS(#CP_PARAMS, 0.02)
SET_CD_PARAMS (0)
LIN XP15 C_Dis C_Dis
;ENDFOLD
   FOR j1 = 1 TO TIMES1+1 STEP 1
      LIN XP15
      WAIT SEC 0 
      ESpos = InitLen1+(j1-1)*Ofs
      MonRef = ESpos
      PassNo = j1
      WAIT SEC 0.1
      ;WAIT FOR (Rposition>(Spos-10)) AND (Rposition < (Spos + 10))      
;FOLD LIN P16 CONT Vel=0.06 m/s CPDAT15 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P16; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDAT15; Kuka.VelocityPath=0.06; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT15
FDAT_ACT = FP16
BAS(#CP_PARAMS, 0.06)
SET_CD_PARAMS (0)
LIN XP16 C_Dis C_Dis
;ENDFOLD
      WAIT SEC 0.1
   PassNo = -11
      LIN XP15
   ENDFOR
   ;----xin zeng buchong damo ----
   IF RemainLen1 >= 0 THEN
      FOR RetryCount1 = 1 TO 10 STEP 1
         LIN XP15
         WAIT SEC 0
         ESpos = InitLen1 + TIMES1 * Ofs + RemainLen1   ; = InitLen1 + LENGTH1
         MonRef = ESpos
         PassNo = TIMES1 + 1 + RetryCount1 +10 
         WAIT SEC 0.1
         DIS12 = ERpos   
;FOLD LIN P16 CONT Vel=0.06 m/s CPDAT18 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P16; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDAT18; Kuka.VelocityPath=0.06; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT18
FDAT_ACT = FP16
BAS(#CP_PARAMS, 0.06)
SET_CD_PARAMS (0)
LIN XP16 C_Dis C_Dis
;ENDFOLD
         WAIT SEC 0.1
         DIS11 = ERpos   
         IF ((InitLen1 + LENGTH1 - DIS11) < 5) AND ((InitLen1 + LENGTH1 - DIS12) < 5) THEN
            WAIT SEC 0
   PassNo = -11
            LIN XP15
            EXIT
         ENDIF
         WAIT SEC 0
   PassNo = -11
         LIN XP15
      ENDFOR
      WAIT SEC 0
   PassNo = -11
   ENDIF
   ;----xin zeng buchong damo ----
   WAIT SEC 0
   PassNo = -11
      
