&ACCESS RVO
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CuMoAllPart2_2( )
   DECL INT TIMES5,j5,InitLen5,RemainLen5,RetryCount5
   DECL INT TIMES6,j6,InitLen6,RemainLen6,RetryCount6
   DECL INT TIMES7,j7,InitLen7,RemainLen7,RetryCount7
   DECL INT TIMES8,j8,InitLen8,RemainLen8,RetryCount8
   DECL REAL tmp5,LENGTH5,DIS51,DIS52,HF1Offset5
   DECL REAL tmp6,LENGTH6,DIS61,DIS62,HF1Offset6
   DECL REAL tmp7,LENGTH7,DIS71,DIS72,HF1Offset7
   DECL REAL tmp8,LENGTH8,DIS81,DIS82,HF1Offset8
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

   MoInitCu()

;---- Detection station 5 : P51 -> P58 -> P52 -> P53 ----
;FOLD SPTP P51 Vel=100 % PDAT5 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=P51; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT5; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
;ENDFOLD
SPTP XP51 WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FP51), $BASE = SBASE(FP51.BASE_NO), $IPO_MODE = SIPO_MODE(FP51.IPO_FRAME), $LOAD = SLOAD(FP51.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT5), $APO = SAPO_PTP(PPDAT5), $GEAR_JERK[1] = SGEAR_JERK(PPDAT5), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
   WAIT SEC 0            
   RecordOn = TRUE
   PassNo   = -5          ; jian ce gong wei 5
;FOLD LIN P58 Vel=0.1 m/s CPDAT57 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P58; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT57; Kuka.VelocityPath=0.1; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT57
FDAT_ACT = FP58
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS (0)
LIN XP58
;ENDFOLD
;FOLD LIN P52 Vel=0.01 m/s CPDAT51 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P52; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT51; Kuka.VelocityPath=0.01; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT51
FDAT_ACT = FP52
BAS(#CP_PARAMS, 0.01)
SET_CD_PARAMS (0)
LIN XP52
;ENDFOLD
   ;FOLD WAIT Time= 0.5 sec ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.logics.wait; Time=2.0
      ;ENDFOLD
      WAIT SEC 0.5
   ;ENDFOLD
   HF1Offset5 = GetHFZ()
   LENGTH5    = HF1Offset5 *100
   tmp5       = LENGTH5/ Ofs
   TIMES5     = MOD(tmp5)
   ;----xin zeng buchong damo ----
   IF LENGTH5 > 0 THEN
      RemainLen5 = LENGTH5 - TIMES5 * Ofs
   ELSE
      RemainLen5 = 0
      LENGTH5    = 0
      TIMES5     = 0
   ENDIF
   ;----xin zeng buchong damo ----
   InitLen5              = FinalPos-((LV1+LV3)/2-AVG5)*100 - GZoffset5 - LENGTH5
   ESpos                 = InitLen5
   MonRef                = ESpos    ; shang chuan jian ce jie guo (InitLen5)
   Baseheight5           = InitLen5 + LENGTH5
   Cuobian5              = LV1-LV3
   Measure_Height5       = HF1Offset5
   GLOBAL_Measure_Height = Measure_Height5
   GLOBAL_LOOPCOUNT      = TIMES5
   Weld_misalignment     = Cuobian5
   GLOBAL_RES_Z          = Baseheight5
   GLOBAL_RES            = (LV1+LV3)*0.5
   
;FOLD LIN P53 Vel=0.1 m/s CPDAT52 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P53; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT52; Kuka.VelocityPath=0.1; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT52
FDAT_ACT = FP53
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS (0)
LIN XP53
;ENDFOLD

