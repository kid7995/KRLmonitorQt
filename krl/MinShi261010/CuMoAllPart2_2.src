LDAT_ACT = LCPDAT53
FDAT_ACT = FP54
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS (0)
LIN XP54
;ENDFOLD
;---- zong qi dong ----
   ;Sspeed = 8000
   ;WAIT FOR Rotation_R>Sspeed-500
      
;FOLD LIN P55 CONT Vel=0.02 m/s CPDAT54 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P55; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDAT54; Kuka.VelocityPath=0.02; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT54
FDAT_ACT = FP55
BAS(#CP_PARAMS, 0.02)
SET_CD_PARAMS (0)
LIN XP55 C_Dis C_Dis
;ENDFOLD
   FOR j5 = 1 TO TIMES5+1 STEP 1
      LIN XP55
      WAIT SEC 0 
      ESpos = InitLen5+(j5-1)*Ofs
      MonRef = ESpos
      PassNo = j5
      WAIT SEC 0.1
      ;WAIT FOR (Rposition>(Spos-10)) AND (Rposition < (Spos + 10))      
;FOLD LIN P56 CONT Vel=0.06 m/s CPDAT55 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P56; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDAT55; Kuka.VelocityPath=0.06; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT55
FDAT_ACT = FP56
BAS(#CP_PARAMS, 0.06)
SET_CD_PARAMS (0)
LIN XP56 C_Dis C_Dis
;ENDFOLD
      WAIT SEC 0.1
   PassNo = -15
      LIN XP55
   ENDFOR
   ;----xin zeng buchong damo ----
   IF RemainLen5 >= 0 THEN
      FOR RetryCount5 = 1 TO 10 STEP 1
         LIN XP55
         WAIT SEC 0
         ESpos  = InitLen5 + TIMES5 * Ofs + RemainLen5   ; = InitLen5 + LENGTH5
         MonRef = ESpos
         PassNo = TIMES5 + 1 + RetryCount5 +10 
         WAIT SEC 0.1
         DIS52  = ERpos   
;FOLD LIN P56 CONT Vel=0.06 m/s CPDAT58 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P56; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDAT58; Kuka.VelocityPath=0.06; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT58
FDAT_ACT = FP56
BAS(#CP_PARAMS, 0.06)
SET_CD_PARAMS (0)
LIN XP56 C_Dis C_Dis
;ENDFOLD
         WAIT SEC 0.1
         DIS51 = ERpos   
         IF ((InitLen5 + LENGTH5 - DIS51) < 5) AND ((InitLen5 + LENGTH5 - DIS52) < 5) THEN
            WAIT SEC 0
   PassNo = -15
            LIN XP55
            EXIT
         ENDIF
         WAIT SEC 0
   PassNo = -15
         LIN XP55
      ENDFOR
      WAIT SEC 0
   PassNo = -15
   ENDIF
   ;----xin zeng buchong damo ----
   WAIT SEC 0
   PassNo = -15
      
