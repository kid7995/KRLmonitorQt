   MoInitXi()

;---- Detection station 5 : P51 -> P58 -> P52 -> P53 ----
;FOLD SPTP P51 Vel=100 % PDAT5 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=P51; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT5; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
;ENDFOLD
SPTP XP51 WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FP51), $BASE = SBASE(FP51.BASE_NO), $IPO_MODE = SIPO_MODE(FP51.IPO_FRAME), $LOAD = SLOAD(FP51.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT5), $APO = SAPO_PTP(PPDAT5), $GEAR_JERK[1] = SGEAR_JERK(PPDAT5), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
   WAIT SEC 0            
   RecordOn = TRUE
   PassNo   = -105          ; jian ce han feng 5 (xi mo)
;FOLD LIN P58 Vel=0.1 m/s CPDAT57 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P58; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT57; Kuka.VelocityPath=0.1; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT57
FDAT_ACT = FP58
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS (0)
LIN XP58
;ENDFOLD
;FOLD LIN P52 Vel=0.01 m/s CPDAT51 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P52; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT51; Kuka.VelocityPath=0.01; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT51
FDAT_ACT = FP52
BAS(#CP_PARAMS, 0.01)
SET_CD_PARAMS (0)
LIN XP52
;ENDFOLD
   ;FOLD WAIT Time= 0.5 sec ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.logics.wait; Time=2.0
      ;ENDFOLD
      WAIT SEC 0.5
   ;ENDFOLD
   HF1Offset5            = GetHFZ()
   LENGTH5               = HF1Offset5 *100
   Poslimit5             = PosShaZhi-((LV1+LV3)/2-AVGShaZhi5)*100 - Posoffset5
   MonRef                = Poslimit5
   Measure_Height5_2     = HF1Offset5
   Cuobian5_2            = LV1-LV3
   Baseheight5_2         = Poslimit5
   GLOBAL_Measure_Height = Measure_Height5_2
   ;---- ECM jian ce jie guo shang bao (xin zeng) ----
   ECM_Seam              = 5
   ECM_WeldH             = Measure_Height5_2
   ECM_BaseH             = Baseheight5_2
   ECM_Misalign          = Cuobian5_2
   ECM_Rounds            = 0                       ;xi mo : wu ji hua lun ci
   Weld_misalignment     = Cuobian5_2
   GLOBAL_RES_Z          = Baseheight5_2 - LENGTH5
   GLOBAL_Poslimit       = Baseheight5_2
   
;FOLD LIN P53 Vel=0.1 m/s CPDAT52 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
