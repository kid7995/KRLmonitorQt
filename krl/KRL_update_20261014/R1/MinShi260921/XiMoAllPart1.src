LIN XP16 C_Dis C_Dis
;ENDFOLD
      WAIT SEC 0
      DIS11 = ERpos
   PassNo = -111
      WAIT SEC 0
      IF j1>1 THEN
         ;IF (DIS11>=Poslimit1) OR (DIS12>=Poslimit1) THEN
         IF (DIS11>=Poslimit1) THEN
            EXIT
         ENDIF
      ENDIF
   ENDFOR
