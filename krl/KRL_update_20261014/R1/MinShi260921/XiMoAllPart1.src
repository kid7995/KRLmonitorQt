&ACCESS RVO
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF XiMoAllPart1( )
   DECL INT TIMES1,j1,InitLen1,Poslimit1
   DECL INT TIMES2,j2,InitLen2,Poslimit2
   DECL INT TIMES3,j3,InitLen3,Poslimit3
   DECL INT TIMES4,j4,InitLen4,Poslimit4
   DECL REAL LENGTH1,DIS11,DIS12,HF1Offset1
   DECL REAL LENGTH2,DIS21,DIS22,HF1Offset2
   DECL REAL LENGTH3,DIS31,DIS32,HF1Offset3
   DECL REAL LENGTH4,DIS41,DIS42,HF1Offset4
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

   MoInitXi()

;---- Detection station 1 : P11 -> P18 -> P12 -> P13 ----
;FOLD SPTP P11 Vel=100 % PDAT1 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=P11; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT1; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
;ENDFOLD
SPTP XP11 WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FP11), $BASE = SBASE(FP11.BASE_NO), $IPO_MODE = SIPO_MODE(FP11.IPO_FRAME), $LOAD = SLOAD(FP11.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT1), $APO = SAPO_PTP(PPDAT1), $GEAR_JERK[1] = SGEAR_JERK(PPDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
   WAIT SEC 0            
   RecordOn = TRUE
   PassNo   = -101          ; jian ce han feng 1 (xi mo)
;FOLD LIN P18 Vel=0.1 m/s CPDAT17 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P18; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT17; Kuka.VelocityPath=0.1; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT17
FDAT_ACT = FP18
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS (0)
LIN XP18
;ENDFOLD
;FOLD LIN P12 Vel=0.01 m/s CPDAT11 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P12; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT11; Kuka.VelocityPath=0.01; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT11
FDAT_ACT = FP12
BAS(#CP_PARAMS, 0.01)
SET_CD_PARAMS (0)
LIN XP12
;ENDFOLD
   ;FOLD WAIT Time= 0.5 sec ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.logics.wait; Time=2.0
      ;ENDFOLD
      WAIT SEC 0.5
   ;ENDFOLD
   HF1Offset1            = GetHFZ()
   LENGTH1               = HF1Offset1 *100
   Poslimit1             = PosShaZhi-((LV1+LV3)/2-AVGShaZhi1)*100 - Posoffset1
   MonRef                = Poslimit1
   Measure_Height1_2     = HF1Offset1
   Cuobian1_2            = LV1-LV3
   Baseheight1_2         = Poslimit1
   GLOBAL_Measure_Height = Measure_Height1_2
   ;---- ECM jian ce jie guo shang bao (xin zeng) ----
   ECM_Seam              = 1
   ECM_WeldH             = Measure_Height1_2
   ECM_BaseH             = Baseheight1_2
   ECM_Misalign          = Cuobian1_2
   ECM_Rounds            = 0                       ;xi mo : wu ji hua lun ci
   Weld_misalignment     = Cuobian1_2
   GLOBAL_RES_Z          = Baseheight1_2 - LENGTH1
   GLOBAL_Poslimit       = Baseheight1_2
   
;FOLD LIN P13 Vel=0.1 m/s CPDAT12 Tool[4]:Tool4 Base[3]:Base3 ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P13; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT12; Kuka.VelocityPath=0.1; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=LIN
;ENDFOLD
$BWDSTART = FALSE
LDAT_ACT = LCPDAT12
FDAT_ACT = FP13
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS (0)
LIN XP13
;ENDFOLD

