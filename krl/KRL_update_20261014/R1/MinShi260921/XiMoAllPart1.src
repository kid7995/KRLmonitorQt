   FOR j1 = 1 TO 30 STEP 1
      ;TRIGGER WHEN DISTANCE = 1 DELAY = 40 DO Rd1() PRIO = -1  
      LIN XP15
      WAIT SEC 0
      PassNo = j1
      DIS12 = ERpos
