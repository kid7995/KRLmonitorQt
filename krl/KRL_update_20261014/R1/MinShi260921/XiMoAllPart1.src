;ENDFOLD
   WAIT SEC 0

;---- Grinding station 1 ----
   PassNo = -111       ; da mo han feng 1 : fei da mo duan (xi mo)
   ESpos = Xi_ESpos_set
   MonRef = Poslimit1
   GLOBAL_Poslimit = Poslimit1
   GLOBAL_RES_Z = Poslimit1 - LENGTH1
